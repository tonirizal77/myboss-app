{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "android-tab",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator-5554",
      "flutterMode": "debug"
    },
    {
      "name": "Chrome (web)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": ["--web-browser-flag=--disable-web-security"],
      "flutterMode": "profile"
    },
    {
      "name": "macOs (desktop)",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      "flutterMode": "debug",
      "runTestsOnDevice": true
      // Note: macOS Xcode project has no per-flavor schemes (only iOS does),
      // so --flavor is not passed here. Env.flavor falls back based on the
      // bundle id, defaulting to Flavor.live when it doesn't match .staging/.prod.
    },
    {
      "name": "Iphone16e",
      "request": "launch",
      "type": "dart",
      "deviceId": "BE8F845D-4BC7-41F9-B94E-D30BE23C194D",
      "flutterMode": "debug",
      "runTestsOnDevice": true,
      "args": ["--flavor", "staging"]
      // "args": ["--flavor", "prod"]
    },

    /// Real Device
    /// -----------
    /// 1. For Android
    {
      "name": "XPrime",
      "request": "launch",
      "type": "dart",
      "deviceId": "0123456789ABCDEF", // usb
      // "deviceId": "192.168.100.189:5555",
      "flutterMode": "debug",
      "runTestsOnDevice": true,
      "args": ["--flavor", "staging"]
      // "args": ["--flavor", "production"]
