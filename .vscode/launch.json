{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "android-tab",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator-5554",
      "flutterMode": "debug",
      "args": ["--android-skip-build-dependency-validation"]
    },
    {
      "name": "Chrome (web)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": ["--web-browser-flag=--disable-web-security"],
      "flutterMode": "profile"
    },
    {
      "name": "macOs staging",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      "flutterMode": "debug",
      "args": ["--flavor", "staging", "--dart-define=DATA_SOURCE=api"]
      // "args": ["--flavor", "prod"]
      // "args": ["--flavor", "live"]
      // Flavors = Xcode schemes Staging / Prod / Live (build configurations
      // Debug-<flavor>, Release-<flavor>, Profile-<flavor>), same as iOS.
    },
    {
      // Mock data (assets/mock) instead of the server - see ServerAccess.
      "name": "macOs staging (mock)",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      "flutterMode": "debug",
      "args": ["--flavor", "staging", "--dart-define=DATA_SOURCE=mock"]
    },
    {
      "name": "Iphone16e",
      "request": "launch",
      "type": "dart",
      "deviceId": "BE8F845D-4BC7-41F9-B94E-D30BE23C194D",
      "flutterMode": "debug",
      "runTestsOnDevice": true,
      "args": ["--flavor", "staging"]
      // "args": ["--flavor", "prod"]
    },

    /// Real Device
    /// -----------
    /// 1. For Android
    {
      "name": "RealmeC85",
      "request": "launch",
      "type": "dart",
      "deviceId": "40cb62ff", // usb
      // "deviceId": "192.168.100.191:5556", // wifi
      // "deviceId": "10.0.0.65:5556", // office
      "flutterMode": "profile",
      "runTestsOnDevice": true,
      "args": [
        "--flavor",
        "staging",
        "--dart-define=DATA_SOURCE=api",
        "--android-skip-build-dependency-validation"
      ]
      // "args": ["--flavor", "prod"]
      // "args": ["--flavor", "live"]
    },
    {
      // Mock data (assets/mock) instead of the server - see ServerAccess.
      "name": "RealmeC85 (mock)",
      "request": "launch",
      "type": "dart",
      "deviceId": "40cb62ff",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "staging",
        "--dart-define=DATA_SOURCE=mock",
        "--android-skip-build-dependency-validation"
      ]
    },
    {
      "name": "XPrime",
      "request": "launch",
      "type": "dart",
      "deviceId": "0123456789ABCDEF", // usb
      // "deviceId": "192.168.100.189:5555",
      "flutterMode": "debug",
      "runTestsOnDevice": true,
      "args": [
        "--flavor",
        "staging",
        "--android-skip-build-dependency-validation"
      ]
      // "args": ["--flavor", "production"]
    },

    /// Build APK (staging)
    /// -------------------
    /// Runs `flutter build apk` in the integrated terminal (no device needed).
    /// Output: build/app/outputs/flutter-apk/app-staging-<mode>.apk
    {
      // Release build is signed with debug keys (see android/app/build.gradle.kts)
      // and is locked to DATA_SOURCE=api by ServerAccess.
      "name": "Build APK staging (release)",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "command": "flutter build apk --release --split-per-abi  --obfuscate --split-debug-info=build/app/outputs/symbols --flavor staging --no-tree-shake-icons --dart-define=DATA_SOURCE=api --android-skip-build-dependency-validation && open build/app/outputs/flutter-apk"
    },
    {
      "name": "Build APK staging (debug)",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "command": "flutter build apk --debug --split-per-abi  --obfuscate --split-debug-info=build/app/outputs/symbols --flavor staging --no-tree-shake-icons --dart-define=DATA_SOURCE=api --android-skip-build-dependency-validation && open build/app/outputs/flutter-apk"
    },

    /// 2. For iOS
    {
      "name": "MyIphone",
      "request": "launch",
      "type": "dart",
      "deviceId": "00008020-000A718E36F9002E",
      "flutterMode": "profile",
      "runTestsOnDevice": true,
      "args": ["--flavor", "staging"]
      // "args": ["--flavor", "prod"]
    },
    {
      "name": "MyIpad",
      "request": "launch",
      "type": "dart",
      "deviceId": "00008030-000D05492653C02E",
      "flutterMode": "debug",
      "runTestsOnDevice": true,
      "args": ["--flavor", "staging"]
      // "args": ["--flavor", "prod"]
    }
  ]
}
